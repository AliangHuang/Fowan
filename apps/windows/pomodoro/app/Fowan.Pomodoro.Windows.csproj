<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(FowanTargetFramework)</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Fowan.Pomodoro.Windows</RootNamespace>
    <Title>Fowan 提醒</Title>
    <Description>本地提醒、待办摘要与番茄钟</Description>
    <AssemblyName Condition="'$(FowanDevelopmentRuntime)' == 'true'">Fowan.Pomodoro.Windows.Dev</AssemblyName>
    <AssemblyName Condition="'$(FowanDevelopmentRuntime)' != 'true'">Fowan.Pomodoro.Windows</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\toolbox\Assets\fowan.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKBootstrapInitialize Condition="'$(WindowsAppSDKSelfContained)' != 'true'">true</WindowsAppSDKBootstrapInitialize>
    <WindowsAppSDKBootstrapAutoInitializeOptions_OnNoMatch_ShowUI Condition="'$(WindowsAppSDKSelfContained)' != 'true'">true</WindowsAppSDKBootstrapAutoInitializeOptions_OnNoMatch_ShowUI>
    <EnableMsixTooling>false</EnableMsixTooling>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(FowanWindowsAppSdkVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\shared\Fowan.Pomodoro.Shared.csproj" />
    <ProjectReference Include="..\..\reminders\contracts\Fowan.Reminders.Contracts.csproj" />
    <ProjectReference Include="..\..\reminders\shared\Fowan.Reminders.Shared.csproj" />
    <ProjectReference Include="..\..\todo\shared\Fowan.Todo.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\toolbox\Assets\fowan.ico" Link="Assets\fowan.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
